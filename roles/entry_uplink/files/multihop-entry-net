#!/usr/bin/env bash
# Entry-server policy routing and fail-closed firewall for user traffic coming
# out of the app container through the Docker bridges ($BRIDGES).
#
# Traffic from a bridge is routed (ip rule priorities):
#   10100  carries the direct mark 0x5a/0xff      -> main (split routing)
#   10110  carries the reply mark 0x5b00/0xff00    -> main (AWG replies)
#   10120  anything, main minus its default route and minus every route via
#          the public interface                    -> main (local/bridge nets)
#   10130  everything else                         -> table 51820
# 10120 suppresses routes through PUBLIC_IFACE by putting that interface in
# its own interface group (PUBLIC_GROUP): providers install DHCP host routes
# via it (e.g. to their resolvers), which bridge traffic must not take.
# Table 51820 holds `default dev awg-uplink` (added by the uplink container)
# and a blackhole default, so with the uplink down traffic is dropped.
# MULTIHOP-FWD (from DOCKER-USER) is the backstop, an allow-list per bridge:
# to awg-uplink, to the bridges, and to the public interface only when
# direct-marked or AWG UDP; anything else from a bridge is dropped.
#
# "AWG traffic" is UDP from a bridge with source port ENTRY_AWG_PORT, in
# either conntrack direction: replies, and packets the AWG server sends after
# the host's conntrack entry for a client expired, both must leave via the
# entry IP. This identifies only the AWG socket because the app container's
# start.sh (entry_app role) masquerades user UDP into a port range that
# excludes ENTRY_AWG_PORT. An app reinstall of amnezia-awg2 (forbidden and
# drift-detected) would drop that rule and with it this guarantee: user UDP
# flows from that port would then leave via the entry IP.
# The reply mark has its own byte (mask 0xff00), disjoint from the direct
# mark's (0xff).
#
# The entry Xray server (ENTRY_XRAY_PORT, empty = off) gets the same
# exception in both modes, keyed on conntrack, never on a source port: only
# the REPLY direction of a connection DNAT'ed to ENTRY_XRAY_PORT is
# reply-marked and let out the public interface by MULTIHOP-FWD.
#
# UPLINK_TRANSPORT selects the uplink. `awg` (default): as above. `reality`
# (spec: docs/superpowers/specs/2026-11-03-xray-only-uplink-addendum.md, 3):
# table 51820 also holds `local default dev lo`, and MULTIHOP-MARK sends
# everything not reply- or direct-marked (force_exit first) to
# MULTIHOP-TPROXY, which RETURNs local and ENTRY_LOCAL_NETS destinations,
# hands TCP and UDP to the local Xray (TPROXY to 127.0.0.1:UPLINK_TPROXY_PORT)
# and drops the rest. A packet from a bridge then goes exactly one way:
#   reply-marked  -> 10110 -> main -> public iface (FWD allows only AWG UDP
#                    and the Xray REPLY match)
#   direct-marked -> 10100 -> main -> public iface (FWD direct-mark rule)
#   local/bridge  -> 10120 -> main -> local or bridge
#   other tcp/udp -> TPROXY socket; 10130 -> 51820 -> `local` -> delivered to
#                    Xray, whose only outbound is the exit. Xray not
#                    listening: TPROXY drops. TPROXY rule missing: local
#                    delivery to no socket (RST/unreachable). `local` route
#                    missing: blackhole. Never forwarded.
#   other protocols -> DROP in MULTIHOP-TPROXY
# and the FWD backstop drops anything else that tries to leave a bridge.
#
# Ordering inside `up` is part of the guarantee: the firewall backstop and the
# blackhole route are in place before any ip rule is touched, every iptables
# chain is rebuilt and swapped in atomically (MULTIHOP-TPROXY is complete
# before MULTIHOP-MARK references it and retired only after no MARK does),
# and ip rules are swapped through a staging priority so a bridge is never
# left without a rule into 51820. A swap interrupted half-way (a staging
# chain still live) is completed by the next `up`, never stripped (see
# resume_chain, install_mark). A bad env fails `up` before any change.
# Runs before Docker at boot, so it must not depend on Docker's chains.
set -euo pipefail

MULTIHOP_ENV="${MULTIHOP_ENV:-/etc/multihop/multihop.env}"
# shellcheck disable=SC1090
. "$MULTIHOP_ENV"

: "${PUBLIC_IFACE:?PUBLIC_IFACE not set in $MULTIHOP_ENV}"
: "${ENTRY_AWG_PORT:?ENTRY_AWG_PORT not set in $MULTIHOP_ENV}"
: "${BRIDGES:?BRIDGES not set in $MULTIHOP_ENV}"
UPLINK_TRANSPORT="${UPLINK_TRANSPORT:-awg}"
UPLINK_TPROXY_PORT="${UPLINK_TPROXY_PORT:-12345}"
ENTRY_XRAY_PORT="${ENTRY_XRAY_PORT:-}"
ENTRY_LOCAL_NETS="${ENTRY_LOCAL_NETS:-}"
RT_TABLES_DIR="${MULTIHOP_RT_TABLES_DIR:-/etc/iproute2/rt_tables.d}"

UPLINK_IFACE=awg-uplink
TABLE=51820
TABLE_NAME=multihop
DIRECT_MARK=0x5a/0xff
REPLY_MARK=0x5b00/0xff00
AWG_UDP="-p udp --sport $ENTRY_AWG_PORT"
DIRECT_SET=multihop_direct
FORCE_EXIT_SET=multihop_force_exit
RULE_PREFS="10100 10110 10120 10130"
PUBLIC_GROUP=51820
# conntrack match for the REPLY direction of connections DNAT'ed to the entry
# Xray's published port (prefixed with -p tcp / -p udp)
XRAY_REPLY="-m conntrack --ctstate DNAT --ctdir REPLY --ctorigdstport $ENTRY_XRAY_PORT"
TPROXY_CHAIN=MULTIHOP-TPROXY
LOCAL_ROUTE="local default dev lo table $TABLE"

die() { echo "${0##*/}: $*" >&2; exit 1; }

# Refuse a bad env before anything changes (the live rules stay as they are).
check_env() {
  case "$UPLINK_TRANSPORT" in
    awg) ;;
    reality) [ -n "$ENTRY_LOCAL_NETS" ] \
               || die "ENTRY_LOCAL_NETS is empty: reality mode would proxy bridge-to-bridge traffic" ;;
    *) die "UPLINK_TRANSPORT must be awg or reality, not '$UPLINK_TRANSPORT'" ;;
  esac
  case "$UPLINK_TPROXY_PORT" in ''|*[!0-9]*) die "UPLINK_TPROXY_PORT is not a port: '$UPLINK_TPROXY_PORT'" ;; esac
  case "$ENTRY_XRAY_PORT" in *[!0-9]*) die "ENTRY_XRAY_PORT is not a port: '$ENTRY_XRAY_PORT'" ;; esac
}

# drop_chain <table> <parent> <chain>: remove every jump from the parent to
# the chain (whatever its match), then flush and delete the chain if present.
drop_chain() {
  local t="$1" parent="$2" c="$3" jump
  while jump=$(iptables -t "$t" -S "$parent" 2>/dev/null | grep -m1 -e " -j $c\$"); do
    # shellcheck disable=SC2086 # "-A <parent> <match> -j <chain>" -> -D args
    iptables -t "$t" -D ${jump#-A }
  done
  if iptables -t "$t" -F "$c" 2>/dev/null; then
    iptables -t "$t" -X "$c" 2>/dev/null || true
  fi
}

chain_exists() { iptables -t "$1" -S "$2" >/dev/null 2>&1; }

# resume_chain <table> <chain>: a run interrupted between retiring <chain>
# and renaming <chain>-NEW left only the staging chain, which is complete
# (jumps to it are added only after it is populated) and may be the parent's
# only jump: finish that rename instead of dropping it. An unreferenced
# partial one (interrupted while populating) is renamed too and then replaced
# like any old chain.
resume_chain() {
  if ! chain_exists "$1" "$2" && chain_exists "$1" "$2-NEW"; then
    iptables -t "$1" -E "$2-NEW" "$2"
  fi
}

# install_chain <table> <parent> <chain> [jump-match...] < rules
# Rules (iptables arguments, one per line) come from stdin. The new chain is
# fully populated and jumped to (once per match; no match = unconditional)
# before the old chain is retired, so the parent is never without it.
install_chain() {
  local t="$1" parent="$2" c="$3" new="$3-NEW" rule m
  shift 3
  [ "$#" -gt 0 ] || set -- ""
  resume_chain "$t" "$c"
  drop_chain "$t" "$parent" "$new"
  iptables -t "$t" -N "$new"
  while read -r rule; do
    # shellcheck disable=SC2086 # word splitting of the rule is intended
    iptables -t "$t" -A "$new" $rule
  done
  for m in "$@"; do
    # shellcheck disable=SC2086
    iptables -t "$t" -I "$parent" $m -j "$new"
  done
  drop_chain "$t" "$parent" "$c"
  iptables -t "$t" -E "$new" "$c"
}

# Docker creates DOCKER-USER and jumps to it from FORWARD, but at boot we run
# before Docker. Docker reuses an existing DOCKER-USER chain and its rules.
ensure_docker_user() {
  iptables -t filter -L DOCKER-USER -n >/dev/null 2>&1 || iptables -t filter -N DOCKER-USER
  iptables -t filter -C FORWARD -j DOCKER-USER 2>/dev/null \
    || iptables -t filter -I FORWARD -j DOCKER-USER
}

# ip6tables may be absent; IPv6 forwarding is also off via sysctl.
ip6_drop() {
  local br
  for br in $BRIDGES; do
    ip6tables -C FORWARD -i "$br" -j DROP 2>/dev/null \
      || ip6tables -I FORWARD -i "$br" -j DROP 2>/dev/null || true
  done
}

ip6_undrop() {
  local br
  for br in $BRIDGES; do
    ip6tables -D FORWARD -i "$br" -j DROP 2>/dev/null || true
  done
}

# Allow-list per bridge: into the uplink, between the bridges, and out the
# public interface only direct-marked, AWG UDP or Xray server replies.
# Everything else from a bridge is dropped, whatever the output interface
# (e.g. a provider private network on another NIC, which rule 10120 may route
# to via main).
fwd_rules() {
  local br out proto
  for br in $BRIDGES; do
    echo "-i $br -o $UPLINK_IFACE -j RETURN"
    for out in $BRIDGES; do echo "-i $br -o $out -j RETURN"; done
    echo "-i $br -o $PUBLIC_IFACE -m mark --mark $DIRECT_MARK -j RETURN"
    echo "-i $br -o $PUBLIC_IFACE $AWG_UDP -j RETURN"
    if [ -n "$ENTRY_XRAY_PORT" ]; then
      for proto in tcp udp; do
        echo "-i $br -o $PUBLIC_IFACE -p $proto $XRAY_REPLY -j RETURN"
      done
    fi
  done
  for br in $BRIDGES; do
    echo "-i $br -j DROP"
  done
}

# mark_rules [tproxy-chain]: MULTIHOP-MARK. Without a chain (awg mode) the
# three rules of the AWG uplink; with one (reality mode) the addendum 3.2
# layout, ending in a jump to it. The reply marks come first in both, so a
# reply to a force_exit address is still marked.
mark_rules() {
  local proto
  echo "$AWG_UDP -j MARK --set-mark $REPLY_MARK"
  if [ -n "$ENTRY_XRAY_PORT" ]; then
    for proto in tcp udp; do
      echo "-p $proto $XRAY_REPLY -j MARK --set-mark $REPLY_MARK"
    done
  fi
  if [ -z "${1:-}" ]; then
    echo "-m set --match-set $FORCE_EXIT_SET dst -j RETURN"
    echo "-m set --match-set $DIRECT_SET dst -j MARK --set-mark $DIRECT_MARK"
    return
  fi
  echo "-m mark --mark $REPLY_MARK -j RETURN"
  echo "-m set --match-set $FORCE_EXIT_SET dst -j $1"
  echo "-m set --match-set $DIRECT_SET dst -j MARK --set-mark $DIRECT_MARK"
  echo "-m mark --mark $DIRECT_MARK -j RETURN"
  echo "-j $1"
}

# MULTIHOP-TPROXY: local and bridge destinations go back to normal routing,
# TCP and UDP to the local Xray, anything else is dropped.
tproxy_rules() {
  local net proto
  echo "-m addrtype --dst-type LOCAL -j RETURN"
  for net in $ENTRY_LOCAL_NETS; do echo "-d $net -j RETURN"; done
  for proto in tcp udp; do
    echo "-p $proto -j TPROXY --on-ip 127.0.0.1 --on-port $UPLINK_TPROXY_PORT"
  done
  echo "-j DROP"
}

# install_mark <jump-match...>: swap MULTIHOP-MARK in (install_chain) and,
# in reality mode, MULTIHOP-TPROXY with it. The TPROXY chain is built
# complete under a staging name, the new MARK references that name, then
# the old TPROXY (referenced only by the old, now retired MARK) is dropped
# and the staging chain renamed (references follow the rename). In awg mode
# MARK without the jumps goes in first, then TPROXY is dropped.
# An interrupted run is completed first, never undone, so the live MARK
# keeps its force_exit jump ahead of the direct mark throughout: MARK absent
# with MARK-NEW present -> rename (resume_chain); MARK jumping to the staging
# TPROXY (interrupted after the MARK swap) -> drop the old, unreferenced
# TPROXY and rename the staging one, which is complete (MARK-NEW references
# it only once it is built). Then the normal swap runs.
install_mark() {
  resume_chain mangle MULTIHOP-MARK
  if [ "$UPLINK_TRANSPORT" = reality ]; then
    local new="$TPROXY_CHAIN-NEW" rule
    if iptables -t mangle -S MULTIHOP-MARK 2>/dev/null | grep -q -e " -j $new\$"; then
      if chain_exists mangle "$TPROXY_CHAIN"; then
        ! iptables -t mangle -S 2>/dev/null | grep -q -e " -j $TPROXY_CHAIN\$" \
          || die "both $TPROXY_CHAIN and $new are referenced; fix by hand (iptables -t mangle -S)"
        iptables -t mangle -F "$TPROXY_CHAIN"
        iptables -t mangle -X "$TPROXY_CHAIN"
      fi
      iptables -t mangle -E "$new" "$TPROXY_CHAIN"
    fi
    # a leftover staging MARK may reference the staging TPROXY
    drop_chain mangle PREROUTING MULTIHOP-MARK-NEW
    drop_chain mangle MULTIHOP-MARK "$new"
    iptables -t mangle -N "$new"
    while read -r rule; do
      # shellcheck disable=SC2086 # word splitting of the rule is intended
      iptables -t mangle -A "$new" $rule
    done < <(tproxy_rules)
    mark_rules "$new" | install_chain mangle PREROUTING MULTIHOP-MARK "$@"
    drop_chain mangle MULTIHOP-MARK "$TPROXY_CHAIN"
    iptables -t mangle -E "$new" "$TPROXY_CHAIN"
  else
    mark_rules | install_chain mangle PREROUTING MULTIHOP-MARK "$@"
    drop_chain mangle MULTIHOP-MARK "$TPROXY_CHAIN-NEW"
    drop_chain mangle MULTIHOP-MARK "$TPROXY_CHAIN"
  fi
}

# rule_selectors <pref>: the ip rule selectors wanted at that priority.
rule_selectors() {
  local br
  case "$1" in
    10100) echo "fwmark $DIRECT_MARK lookup main" ;;
    10110) echo "fwmark $REPLY_MARK lookup main" ;;
    10120) for br in $BRIDGES; do
             echo "iif $br lookup main suppress_prefixlength 0 suppress_ifgroup $PUBLIC_GROUP"
           done ;;
    10130) for br in $BRIDGES; do echo "iif $br lookup $TABLE"; done ;;
  esac
}

del_pref() {
  while ip rule del pref "$1" 2>/dev/null; do :; done
}

add_rules() { # <pref> < selectors
  local sel
  while read -r sel; do
    # shellcheck disable=SC2086
    ip rule add pref "$1" $sel
  done
}

# Each priority p is swapped through staging priority p+1 (still below the
# next level): add the wanted rules at p+1, clear p, add them at p, clear
# p+1. Stale rules (old port, removed bridge) disappear with the clear, and
# at every step each bridge keeps a rule of the same meaning.
install_rules() {
  local p s
  for p in $RULE_PREFS; do
    s=$((p + 1))
    del_pref "$s"
    rule_selectors "$p" | add_rules "$s"
    del_pref "$p"
    rule_selectors "$p" | add_rules "$p"
    del_pref "$s"
  done
}

up() {
  check_env
  if [ "$(cat "$RT_TABLES_DIR/$TABLE_NAME.conf" 2>/dev/null)" != "$TABLE $TABLE_NAME" ]; then
    mkdir -p "$RT_TABLES_DIR"
    echo "$TABLE $TABLE_NAME" > "$RT_TABLES_DIR/$TABLE_NAME.conf"
  fi

  # 1. Fail-closed backstop first (the rt_tables name above has no effect on
  #    traffic).
  ensure_docker_user
  fwd_rules | install_chain filter DOCKER-USER MULTIHOP-FWD
  ip6_drop

  # 2. Marking (one PREROUTING jump per bridge, so the chain only ever sees
  #    bridge traffic; in reality mode with MULTIHOP-TPROXY), NAT and MSS
  #    clamp. The reply marks come before the force_exit rule so a reply to
  #    a force_exit address is still marked.
  ipset create "$DIRECT_SET" hash:net -exist
  ipset create "$FORCE_EXIT_SET" hash:net -exist
  local br jumps=()
  for br in $BRIDGES; do jumps+=("-i $br"); done
  install_mark "${jumps[@]}"
  install_chain nat POSTROUTING MULTIHOP-NAT <<RULES
-o $UPLINK_IFACE -j MASQUERADE
RULES
  install_chain mangle FORWARD MULTIHOP-MSS <<RULES
-o $UPLINK_IFACE -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
RULES

  # 3. Blackhole before any rule points at the table (an empty table would
  #    fall through to main), the public interface's group before the rule
  #    that suppresses it, then the rules. A missing interface (not up yet)
  #    only loses the group: its routes then hit the FWD backstop (dropped).
  #    Reality mode adds the `local` route (local delivery to the TPROXY
  #    socket); awg mode removes it, leaving the uplink's route and the
  #    blackhole.
  ip route replace blackhole default metric 4096 table "$TABLE"
  if [ "$UPLINK_TRANSPORT" = reality ]; then
    # shellcheck disable=SC2086
    ip route replace $LOCAL_ROUTE
  else
    # shellcheck disable=SC2086
    ip route del $LOCAL_ROUTE 2>/dev/null || true
  fi
  ip link set dev "$PUBLIC_IFACE" group "$PUBLIC_GROUP" \
    || echo "${0##*/}: cannot set the group of $PUBLIC_IFACE; bridge traffic to its non-default routes is dropped" >&2
  install_rules
}

# Removes everything. Bridge traffic then follows the main table: stop
# amnezia-awg2 first. The systemd unit deliberately never calls this.
down() {
  local p
  for p in $RULE_PREFS; do
    del_pref "$p"
    del_pref $((p + 1))
  done
  # shellcheck disable=SC2086
  ip route del $LOCAL_ROUTE 2>/dev/null || true
  ip route del blackhole default metric 4096 table "$TABLE" 2>/dev/null || true
  ip link set dev "$PUBLIC_IFACE" group default 2>/dev/null || true
  local spec
  # MULTIHOP-TPROXY after MULTIHOP-MARK, which references it
  for spec in "mangle PREROUTING MULTIHOP-MARK" "mangle MULTIHOP-MARK $TPROXY_CHAIN" \
              "nat POSTROUTING MULTIHOP-NAT" \
              "mangle FORWARD MULTIHOP-MSS" "filter DOCKER-USER MULTIHOP-FWD"; do
    # shellcheck disable=SC2086
    set -- $spec
    drop_chain "$1" "$2" "$3-NEW"
    drop_chain "$1" "$2" "$3"
  done
  ip6_undrop
}

case "${1:-}" in
  up) up ;;
  down) down ;;
  *) echo "usage: ${0##*/} up|down" >&2; exit 2 ;;
esac
