#!/usr/bin/env bash
# Re-resolve EXIT_DOMAIN when the address changed: repoint the AWG uplink peer,
# or in reality mode restart the uplink Xray (it resolves the domain only at
# start). A failed, empty or malformed resolution never touches anything.
set -euo pipefail

MULTIHOP_ENV="${MULTIHOP_ENV:-/etc/multihop/multihop.env}"
# shellcheck disable=SC1090
. "$MULTIHOP_ENV"

: "${EXIT_DOMAIN:?EXIT_DOMAIN not set in $MULTIHOP_ENV}"
UPLINK_TRANSPORT="${UPLINK_TRANSPORT:-awg}"
if [ "$UPLINK_TRANSPORT" != reality ]; then
  : "${EXIT_PORT:?EXIT_PORT not set in $MULTIHOP_ENV}"
  : "${EXIT_PUBKEY:?EXIT_PUBKEY not set in $MULTIHOP_ENV}"
fi
CONTAINER=multihop-uplink
IFACE=awg-uplink

log() { echo "${0##*/}: $*" >&2; }

# Keep the public interface in the group that rule 10120 (multihop-entry-net)
# suppresses: a renamed or re-created NIC loses it, and then container DNS
# via provider host routes is dropped again. Cheap and idempotent.
if [ -n "${PUBLIC_IFACE:-}" ]; then
  ip link set dev "$PUBLIC_IFACE" group 51820 || log "cannot set the group of $PUBLIC_IFACE"
fi

addr=$(getent ahostsv4 "$EXIT_DOMAIN" | awk 'NR==1{print $1}') || addr=""
if ! [[ "$addr" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]]; then
  log "cannot resolve $EXIT_DOMAIN (got '${addr}'), keeping current endpoint"
  exit 0
fi

if [ "$UPLINK_TRANSPORT" = reality ]; then
  : "${UPLINK_STATE_DIR:?UPLINK_STATE_DIR not set in $MULTIHOP_ENV}"
  state="$UPLINK_STATE_DIR/exit-ip"
  old=""
  [ -r "$state" ] && old=$(cat "$state")
  [ "$old" = "$addr" ] && exit 0
  # First run only records the address: the container just started with it.
  if [ -n "$old" ]; then
    log "exit address $old -> $addr, restarting multihop-uplink-xray"
    docker restart multihop-uplink-xray >/dev/null
  fi
  # Written after a successful restart, so a failed one is retried next run.
  echo "$addr" > "$state"
  exit 0
fi

want="$addr:$EXIT_PORT"

peers=$(docker exec "$CONTAINER" awg show "$IFACE" endpoints)
# `awg set ... peer <key>` would create a new peer; never do that.
if ! awk -v k="$EXIT_PUBKEY" '$1 == k {f = 1} END {exit !f}' <<<"$peers"; then
  log "peer $EXIT_PUBKEY not on $IFACE, refusing to add it"
  exit 1
fi
cur=$(awk -v k="$EXIT_PUBKEY" '$1 == k {print $2}' <<<"$peers")
[ "$cur" = "$want" ] && exit 0

log "exit endpoint ${cur:-(none)} -> $want"
docker exec "$CONTAINER" awg set "$IFACE" peer "$EXIT_PUBKEY" endpoint "$want"
